---
import { rasterize } from '../../lib/pixel-highlighter/raster';
import { domSource, domTextSize, highlightedHtml } from '../../lib/pixel-highlighter/dom-intro';
import './article.css';

const lines = 10;
const source = domSource(lines);
const result = rasterize(source);
const spans = result.tokens.flat().filter(token => token.content).length;
const html = highlightedHtml(result.tokens);
---
<figure id="dom-overhead" class="pixel-figure pixel-wide pixel-dom-intro" data-dom-intro>
  <div class="pixel-toolbar">
    <span class="pixel-title">How much DOM does highlighting add?</span>
    <label for="dom-intro-lines">Lines of code <output for="dom-intro-lines" data-dom-line-value>{lines}</output></label>
    <input id="dom-intro-lines" type="range" min="1" max="100" step="1" value={lines} aria-label="Lines of code" disabled />
  </div>
  <div class="pixel-dom-totals">
    <div><strong data-dom-lines>{lines}</strong><span data-dom-line-label>lines of code</span></div>
    <div><strong data-dom-spans>{spans.toLocaleString('en')}</strong><span>token spans</span></div>
    <div><strong data-dom-total>{(spans + 2).toLocaleString('en')}</strong><span>elements in the block</span></div>
  </div>
  <div class="pixel-dom-views">
    <div>
      <div class="pixel-dom-heading"><div><p>Highlighted code</p><small data-dom-code-size>{domTextSize(source)}</small></div></div>
      <pre class="pixel-dom-source"><code data-dom-source>{result.tokens.map((line, y) => <Fragment>{line.filter(token => token.content).map(token => <span style={`color:${token.color}`}>{token.content}</span>)}{y < result.tokens.length - 1 ? '\n' : ''}</Fragment>)}</code></pre>
    </div>
    <div>
      <div class="pixel-dom-heading">
        <div><p>Generated HTML</p><small><span data-dom-html-size>{domTextSize(html)}</span><output data-dom-zoom hidden></output></small></div>
        <button type="button" data-dom-toggle-view aria-controls="dom-intro-html-view" hidden>Read HTML</button>
      </div>
      <div id="dom-intro-html-view" class="pixel-dom-html-view" data-dom-html-view data-view="read" role="region" aria-label="Generated HTML" tabindex="0">
        <pre class="pixel-dom-html" data-dom-html>{html}</pre>
      </div>
    </div>
  </div>
  <figcaption>The full HTML scales to fit. Choose “Read HTML” for normal-size text. Counts cover only <code>pre</code>, <code>code</code> and token spans; sizes are uncompressed UTF-8. Other highlighters may add line wrappers too.</figcaption>
  <p class="pixel-sr-only" data-dom-status role="status">{lines} lines of code create {spans} token spans and {spans + 2} elements in this renderer.</p>
</figure>
