---
import { sample } from '../../lib/pixel-highlighter/raster';
import './pixel.css';
---
<figure class="pixel-demo" data-browser-demo>
  <figcaption>The color pixels, enlarged. Below: the same image clipped to text.</figcaption>
  <div class="pixel-map" role="img" aria-label="Color grid: one column per character position, one row per line"></div>
  <pre class="pixel-shell"><code class="pixel-text">{sample}</code></pre>
  <p class="pixel-status" aria-live="polite">Without JavaScript, the code remains readable.</p>
</figure>
<script>
  import { browserBackground } from '../../lib/pixel-highlighter/browser';
  async function renderDemo(root: HTMLElement) {
    const code = root.querySelector<HTMLElement>('code')!;
    const map = root.querySelector<HTMLElement>('.pixel-map')!;
    const status = root.querySelector<HTMLElement>('.pixel-status')!;
    try {
      const result = browserBackground(code.textContent ?? '');
      const image = new Image();
      image.src = result.image;
      await image.decode();
      code.style.setProperty('--pixel-image', `url(${result.image})`);
      code.style.setProperty('--pixel-size', result.size);
      code.dataset.ready = '';
      map.style.backgroundImage = `url(${result.image})`;
      status.textContent = `${result.width} × ${result.height} pixels · 2 elements for the code block · 0 token spans`;
    } catch {
      status.textContent = 'The image could not be generated. The code remains readable.';
    }
  }
  document.querySelectorAll<HTMLElement>('[data-browser-demo]').forEach(renderDemo);
</script>
