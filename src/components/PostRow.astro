---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl } from '../lib/posts';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, description, date, externalUrl, source, gallery, preview } = post.data;
const images = gallery.length ? gallery.slice(0, 3) : preview ? [{ src: preview.image, alt: preview.alt }] : [];
---
<li>
  <article aria-labelledby={`title-${post.id}`}>
    <a href={postUrl(post)} target={externalUrl ? '_blank' : undefined} rel={externalUrl ? 'noopener noreferrer' : undefined} aria-labelledby={`title-${post.id}`} class:list={['post-link', { 'post-text-only': !images.length }]}>
      {images.length > 0 && <div class:list={['post-art', { 'post-art-stack': images.length > 1 }]}>
        {images.map((image, imageIndex) => <div class="post-card" style={`--card-index: ${imageIndex}`}>
          <Image src={image.src} alt={image.alt} width={440} class="post-image" loading="lazy" />
        </div>)}
      </div>}
      <div class="post-copy">
        <time class="post-date" datetime={date.toISOString()}>{formatDate(date)}</time>
        <h3 id={`title-${post.id}`}>{title}</h3>
        <p class="post-description">{description}</p>
        {(source || preview) && <p class="post-meta">{source}{source && preview && <span aria-hidden="true"> · </span>}{preview?.readingTime}{externalUrl && <><img src="/images/external-link.svg" alt="" class="external-icon" width="14" height="17" /><span class="sr-only"> (opens in a new tab)</span></>}</p>}
      </div>
    </a>
  </article>
</li>
