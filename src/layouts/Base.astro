---
import '@fontsource/inter/latin-400.css';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'de';
  article?: boolean;
  publishedAt?: Date;
  noindex?: boolean;
}
const { title = profile.name, description = profile.about, lang = 'en', article = false, publishedAt, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Lukas Bombach — Writing" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title === profile.name ? title : `${title} — ${profile.name}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell"><slot /></div>
  </body>
</html>
