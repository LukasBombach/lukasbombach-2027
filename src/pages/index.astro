---
import portrait from '../assets/lukas-bombach.png';
import Base from '../layouts/Base.astro';
import Profile from '../components/Profile.astro';
import PostRow from '../components/PostRow.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { getPublishedPosts, postUrl } from '../lib/posts';
const posts = await getPublishedPosts();
const homeUrl = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${homeUrl}#profile`,
  url: homeUrl,
  name: `${profile.name} — Web Developer in Berlin`,
  description: profile.about,
  inLanguage: 'en',
  hasPart: posts.map(post => ({
    '@type': 'BlogPosting',
    '@id': new URL(postUrl(post), Astro.site).href,
    url: new URL(postUrl(post), Astro.site).href,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString().slice(0, 10),
    inLanguage: post.data.lang,
    author: { '@id': `${homeUrl}#person` },
  })),
  mainEntity: {
    '@type': 'Person',
    '@id': `${homeUrl}#person`,
    name: profile.name,
    url: homeUrl,
    image: new URL(portrait.src, Astro.site).href,
    description: profile.about,
    jobTitle: 'Web Developer',
    sameAs: [...new Set([profile.github, ...profile.contacts.map(contact => contact.url)])],
  },
};
---
<Base home>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <div class="home-intro"><Profile home /></div>
  <main id="main" tabindex="-1" class="home-main">
    <section aria-labelledby="about-title" class="home-intro">
      <h2 id="about-title" class="section-title mb-1">About</h2>
      <p>{profile.about}</p>
    </section>
    <section aria-labelledby="writing-title">
      <h2 id="writing-title" class="sr-only">Writing</h2>
      {posts.length ? <ul class="post-list" role="list">{posts.map(post => <PostRow post={post} />)}</ul> : <p>New writing is on its way.</p>}
    </section>
  </main>
  <div class="home-intro"><Footer /></div>
</Base>
